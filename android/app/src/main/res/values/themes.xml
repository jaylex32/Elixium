<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="Theme.Elixium" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:windowBackground">@color/ground</item>
    <item name="android:statusBarColor">@color/ground</item>
    <item name="android:navigationBarColor">@color/ground</item>
  </style>

  <!-- The default button is light grey, which reads as a foreign control in a
       dark interface. -->
  <style name="ElixiumButton" parent="Widget.AppCompat.Button">
    <item name="android:backgroundTint">@color/accent</item>
    <item name="android:textColor">@color/ground</item>
    <item name="android:textStyle">bold</item>
    <item name="android:paddingTop">14dp</item>
    <item name="android:paddingBottom">14dp</item>
  </style>
</resources>
