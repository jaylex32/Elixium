{
  "name": "elixium-desktop",
  "version": "1.5.0",
  "private": true,
  "description": "Desktop shell for Elixium",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icons": "node make-icons.js",
    "prestart": "node make-icons.js",
    "predist": "node check-packaged-files.js && node patch-portable-template.js && node make-icons.js",
    "check:packaging": "node check-packaged-files.js",
    "dist": "electron-builder && node check-no-secrets.js",
    "check:secrets": "node check-no-secrets.js",
    "smoke": "electron smoke-render.js",
    "patch:portable": "node patch-portable-template.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
