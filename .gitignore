# Logs
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env
.env.test

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# yarn v2
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# d-fi files and directories
d-fi_*
d-fi.config.json
build/
Music/
Playlist/

# Elixium local state and release artifacts
elixium.config.json
elixium.watchlist.json
elixium.favorites.json
elixium.exe
binaries/
.pkg-cache/
.pkg-cache-elixium/
temp/
Recycle/
test-results/
.tmp*
.tmp_*/
nul
.claude/

# Packaged binaries produced by pkg for a GitHub release.
release/

# Electron desktop shell build output and dependencies.
desktop/node_modules/
desktop/out/
desktop/launch.log

# pkg's Node base binaries, kept in the workspace so the icon stamped onto the
# Windows one cannot leak into a shared cache and become the base for other
# projects built on the same machine.
.pkg-cache/

# Icons generated from elixium-icon.svg by desktop/make-icons.js, which runs
# from prestart/predist. The web UI's PNG copies are committed instead — the
# Vite build has no equivalent hook to regenerate them.
desktop/build/
desktop/assets/
desktop/smoke-report.txt
